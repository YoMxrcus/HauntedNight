  m_Script: {fileID: 11500000, guid: 7bea55e231277cd418a21ff37e351443, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookSprite: {fileID: 21300000, guid: 5d2e582a834e1a842816077df2d42b1c, type: 3}
  storyText: "This is as far as I can go.\nThe monster hit me\u2026 and the blow
    was fatal.\nThe end is very close now.\n\nI can barely feel myself breathing.\nEvery
    time I try to write, my hands feel more distant, like they no longer belong to
    me.\n\nMy daughter\u2026 I\u2019m sorry if I don\u2019t get to see you again.\nI
    hope you grow up strong, and that you live a good life.\nI wish I could be there
    to watch you grow, but my fate is sealed.\n\nI loved you more than anything.\nAnd
    if there is a heaven\u2026 I will be watching over you from above."
  bookUI: {fileID: 1748374944}
  interactDistance: 2
