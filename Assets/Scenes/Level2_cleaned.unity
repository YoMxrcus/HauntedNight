--- !u!114 &537292183
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 537292181}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7bea55e231277cd418a21ff37e351443, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookSprite: {fileID: 21300000, guid: 5d2e582a834e1a842816077df2d42b1c, type: 3}
  storyText: "I must have fallen asleep\u2026\n\nWhen I opened my eyes, something
    was standing there\u2014watching me.\nThen it ran.\n\nI didn\u2019t think. I
    ran toward the key that led me here.\n\nI don\u2019t know how much longer my
    body can take this.\nThis place is dark. Empty. Frozen.\n\nBut I can\u2019t stop.\nMy
    wife\u2026 my daughter\u2026 they\u2019re waiting for me.\n\nI remember the path
    now.\nBack to the room on the left. Through the hidden passage.\nAround in a
    circle, and then back to the room on my right.\nThat\u2019s where the next key
    is.\n\nI just need to last a little longer."
  bookUI: {fileID: 1748374944}
  interactDistance: 2
