  m_Script: {fileID: 11500000, guid: 7bea55e231277cd418a21ff37e351443, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookSprite: {fileID: 21300000, guid: 5d2e582a834e1a842816077df2d42b1c, type: 3}
  storyText: "I don\u2019t think I can handle this anymore.\nI\u2019m hurt, and I\u2019ve
    already lost so much blood.\nI don\u2019t think I\u2019ll survive long enough
    to get out.\n\nI found a map\u2026 it showed the location of every key.\nI remember
    the path: go to the rooms on the right, follow the circular hallway, and find
    the key to escape this place.\nThat key should lead to another room\u2026 and
    inside it, another key.\n\nBut I don\u2019t feel good anymore.\nMy vision is
    fading.\nI think\u2026 I\u2019m going to fall asleep."
  bookUI: {fileID: 1748374944}
  interactDistance: 2
